<Project>
    <!--
        The game's own assemblies, for every project that runs the mod outside the game.

        The mod uses what the game already gives it - TextPtr and StringSegment for reading scripts, to
        begin with - rather than rebuilding any of it. So anything that runs the mod outside the game
        needs the real assemblies: the tests and the harness. The mod project references the game on its
        own and does not import this.

        The package finds the game from an mdk.local.ini beside each project (gitignored, one line:
        binarypath=...), and copies the assemblies into bin because nothing here runs inside the game.
        They are Keen's and are never redistributed; bin is not checked in.
    -->
    <PropertyGroup>
        <SpaceEngineersBinCopyLocal>true</SpaceEngineersBinCopyLocal>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
        Only the assemblies this code uses, and not the rest the package brings.

        <b>Sandbox.Graphics and the render assemblies stay out</b>, because nothing outside the game has
        any business drawing.

        Sandbox.Game is in, because the screens draw through an interface rather than through its
        statics: where a call lands is decided by which IScreenSpace was handed over, not by which
        assembly happens to be in scope. The same for toolbars, through ISlots. Those two are the
        whole of what the harness has to answer for; everything else it uses for real.

        This set grows by name, one assembly at a time, as the code starts using something from it.
    -->
    <Target Name="ReferenceOnlyWhatCoreUses" AfterTargets="SpaceEngineers">
        <ItemGroup>
            <Reference Remove="System.Collections.Immutable;Sandbox.Graphics;VRage.Audio;VRage.Render;VRage.Render11;VRage.Scripting" />
        </ItemGroup>
    </Target>
</Project>
