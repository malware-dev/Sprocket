<Project>
    <!--
        The game's own assemblies, for every project that compiles core or runs it outside the game.

        Core is the mod's code first, and uses what the game already gives a mod - TextPtr and
        StringSegment for reading scripts, to begin with - rather than rebuilding it. So anything that runs
        core outside the game needs the real assemblies: core itself, the tests, and the simulator. The mod
        project references the game on its own and does not import this.

        The package finds the game from an mdk.local.ini beside each project (gitignored, one line:
        binarypath=...), and copies the assemblies into bin because nothing here runs inside the game.
        They are Keen's and are never redistributed; bin is not checked in.
    -->
    <PropertyGroup>
        <SpaceEngineersBinCopyLocal>true</SpaceEngineersBinCopyLocal>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
        Only the assemblies core uses, and not the rest the package brings.

        The simulator stands in for the game's maths and drawing types with substitutes of its own, and
        seeing the real VRage.Math beside them makes Point ambiguous and every Vector2 and Color a
        collision. So this reference set grows by name, one assembly at a time, as core starts using
        something from it. A name the package adds later and nobody removed here shows up as a collision -
        loud, which is the right way for it to fail.
    -->
    <Target Name="ReferenceOnlyWhatCoreUses" AfterTargets="SpaceEngineers">
        <ItemGroup>
            <Reference Remove="System.Collections.Immutable;Sandbox.Common;Sandbox.Game;Sandbox.Graphics;SpaceEngineers.Game;SpaceEngineers.ObjectBuilders;VRage;VRage.Audio;VRage.Input;VRage.Library;VRage.Math;VRage.Render;VRage.Render11;VRage.Scripting;ProtoBuf.Net.Core" />
        </ItemGroup>
    </Target>
</Project>
