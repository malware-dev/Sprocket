<Project>
    <!--
        Settings for every project that compiles Reactor.Core's sources.

        Reactor.Core is consumed two completely different ways:

          1. As a normal assembly reference by the Avalonia host and the tests.
          2. As LOOSE SOURCE FILES by the Space Engineers mod, because SE does not
             load assemblies - it compiles a mod's .cs files in-game with its own
             bundled Roslyn, under a whitelist.

        That second path is the binding constraint, and it fails silently: write a
        record or a tuple on a Tuesday and you find out in-game weeks later. So the
        ceiling is enforced by the compiler here instead, on every build.

        netstandard2.0 does most of the work by itself - its API surface is roughly
        .NET Framework 4.6.1 shaped, so most of SE's whitelist problem simply cannot
        be expressed. LangVersion pins the rest.

        C# 6 is the conservative assumption for SE's in-game compiler. Raising it is
        a one-line change here once the real ceiling has been verified in-game.
    -->
    <PropertyGroup>
        <LangVersion>6</LangVersion>

        <!-- Nullable reference types are C# 8. The #nullable directive is a hard
             error on an older compiler, so core code cannot use them at all. -->
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>

        <!-- Core runs inside a 60Hz game loop. Unused/unreachable code and
             accidental allocations are worth hearing about. -->
        <WarningLevel>5</WarningLevel>
    </PropertyGroup>
</Project>
