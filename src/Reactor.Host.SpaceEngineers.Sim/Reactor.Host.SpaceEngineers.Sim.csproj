<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\build\Reactor.GameReferences.props" />

    <PropertyGroup>
        <OutputType>WinExe</OutputType>

        <!--
            The framework the mod's own target is, which is what MDK spells netframework48. So the mod is
            a project reference here rather than a second compilation of its sources: one assembly, built
            once, with its analysers and its whitelist over it, and the harness drives that.
        -->
        <TargetFramework>net48</TargetFramework>
        <UseWPF>true</UseWPF>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Reactor.Sim</RootNamespace>
        <AssemblyName>Reactor.Host.SpaceEngineers.Sim</AssemblyName>
        <Platforms>x64</Platforms>
        <Configurations>Debug;Release</Configurations>

        <!-- "annotations" rather than "enable": the syntax is understood, and no warnings are raised
             against code written years before it existed. -->
        <Nullable>annotations</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>

        <!-- For copying the decoded font page about, which is a megapixel of bytes and is done once per
             colour. Confined to the two loops in GlyphAtlas that actually need it. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!--
        The symbol font the mod ships, copied so the simulator draws the same glyphs the game will.
        Referenced where it lives rather than duplicated: one page, one set of metrics, and no chance of
        the harness showing symbols the mod does not have.
    -->
    <ItemGroup>
        <None Include="..\Reactor.Host.SpaceEngineers\Content\Fonts\Maltek\**\*">
            <Link>Content\Fonts\Maltek\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <!-- Impersonates the game's interfaces at runtime, so the harness answers the dozen members
             the mod reads instead of implementing the several hundred it does not. Harness only. -->
        <PackageReference Include="Castle.Core" Version="5.1.1" />

        <!-- The game ships its artwork as block-compressed DDS, which nothing in .NET reads. This is the
             same decoder Malforge's DocGen and MyTsDesigner already use, for the same job; a third
             hand-written BC1 unpacker would only be a third place to get it wrong.

             Touched only on a machine that has the game, because what it produces is cached as PNG and
             it is the cache the other machine reads. It is a managed wrapper over a native library, so
             it loads when it is first called and not before. -->
        <PackageReference Include="DirectXTexNet" Version="1.0.1" />
    </ItemGroup>

    <!--
        The mod's own code, compiled here as well as into the mod, on the same framework the mod builds
        against.

        Not a port and not a stand-in: the harness drives the same GridWorld and ReactorUnit the game
        drives, over blocks it makes up, which is what puts the toolbar and storage layer - the fiddliest
        code in the repo - under the reference frames.

        <b>Compiled rather than referenced, and that is not a preference.</b> What the game declares in
        Sandbox.Game - the screen-space drawing the editor renders through, the screen host's base, mod
        storage, the toolbar conveniences - the harness declares itself, so that a frame can be recorded
        rather than drawn. A declaration like that only wins inside the assembly that makes it: reference
        the mod's own assembly instead and its drawing binds to the real thing, which outside the game
        draws nothing and then throws. See Fakes, and build/Reactor.GameReferences.props.
    -->
    <ItemGroup>
        <Compile Include="..\Reactor.Host.SpaceEngineers\**\*.cs"
                 Exclude="..\Reactor.Host.SpaceEngineers\obj\**\*.cs;..\Reactor.Host.SpaceEngineers\bin\**\*.cs;..\Reactor.Host.SpaceEngineers\**\*.debug.cs">
            <Link>Mod\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>
    </ItemGroup>

</Project>
