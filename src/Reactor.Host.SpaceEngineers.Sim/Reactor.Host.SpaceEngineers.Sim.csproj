<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\build\Reactor.GameReferences.props" />

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Reactor.Sim</RootNamespace>
        <AssemblyName>Reactor.Host.SpaceEngineers.Sim</AssemblyName>

        <!-- The mod's sources are compiled here as well as into the mod, so they are compiled the way
             the mod compiles them: the game's compiler is C# 6 and has neither of these, and a source
             file that leans on an implicit using here would fail there. "annotations" rather than
             "enable": the syntax is understood, and no warnings are raised against code written years
             before it existed. -->
        <Nullable>annotations</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>

        <!-- For copying the decoded font page about, which is a megapixel of bytes and is done once per
             colour. Confined to the two loops in GlyphAtlas that actually need it. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!--
        The symbol font the mod ships, copied so the simulator draws the same glyphs the game will.
        Referenced where it lives rather than duplicated: one page, one set of metrics, and no chance of
        the harness showing symbols the mod does not have.
    -->
    <ItemGroup>
        <None Include="..\Reactor.Host.SpaceEngineers\Content\Fonts\Maltek\**\*">
            <Link>Content\Fonts\Maltek\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <!-- Impersonates the game's interfaces at runtime, so the harness answers the dozen members
             the mod reads instead of implementing the several hundred it does not. Harness only. -->
        <PackageReference Include="Castle.Core" Version="5.1.1" />

        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />

        <!-- The game ships its artwork as block-compressed DDS, which nothing in .NET reads. This is the
             same decoder Malforge's DocGen and MyTsDesigner already use, for the same job; a third
             hand-written BC1 unpacker would only be a third place to get it wrong.

             Touched only on a machine that has the game, because what it produces is cached as PNG and
             it is the cache the other machine reads. It is a managed wrapper over a native library, so
             it loads when it is first called and not before. -->
        <PackageReference Include="DirectXTexNet" Version="1.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Reactor.Core\Reactor.Core.csproj" />
    </ItemGroup>

    <!--
        The mod's own code, compiled here as well as into the mod.

        Not a port and not a stand-in: the harness drives the same GridWorld and ReactorUnit the game
        drives, over blocks it makes up. That is what puts the toolbar and storage layer - the fiddliest
        code in the repo - under the reference frames.

        All of it, including the screen host: what the game declares in Sandbox.Game - the screen host's
        base, mod storage, the toolbar conveniences - the harness declares itself, because that assembly
        also holds the screen-space types a recorded frame depends on. See Fakes, and
        build/Reactor.GameReferences.props.
    -->
    <ItemGroup>
        <Compile Include="..\Reactor.Host.SpaceEngineers\**\*.cs"
                 Exclude="..\Reactor.Host.SpaceEngineers\obj\**\*.cs;..\Reactor.Host.SpaceEngineers\bin\**\*.cs">
            <Link>Mod\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>
    </ItemGroup>

    <!-- The same files the mod compiles. Not a copy, not a port: if it draws here it draws there. -->

    <!-- And the same simulated ship the Avalonia host runs the editor against, so the two targets are
         driven by one world rather than by two hand-made approximations of one. -->

    <!-- This target's editor. Shared rather than owned, because these are the files the mod will ship:
         what is seen in this window is what a player sees, not a preview of it. -->
    <Import Project="..\Reactor.Host.SpaceEngineers.Presentation.Mixin\Reactor.Host.SpaceEngineers.Presentation.Mixin.projitems" Label="Shared" />
</Project>
