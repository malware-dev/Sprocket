<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <TransparentMaterials>
        <!--
            Phosphor draws sprites by material id, and these are the ones it needs to exist.

            The textures are the game's own, so this mod ships no art. That is not only about size: the cursor
            a player already knows is the right cursor to draw, and there is no id to reach it by, because
            GuiTextures.sbc never names it. Declaring a material pointing at the same file is the way to it.
        -->

        <!-- Flat white, tinted to whatever colour is asked for. Blank rather than an LCD square, so a colour
             multiply lands on exactly the tone requested instead of on whatever the sprite already was. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Phosphor_Fill</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\GUI\Blank.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- The game's own arrow. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Phosphor_Cursor</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\GUI\MouseCursor.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- The game's own hand, for when the thing under the pointer can be pressed. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Phosphor_CursorHand</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\GUI\MouseCursorHand.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>
    </TransparentMaterials>
</Definitions>
