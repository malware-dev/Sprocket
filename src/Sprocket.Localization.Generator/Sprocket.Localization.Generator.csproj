<Project Sdk="Microsoft.NET.Sdk">
  <!--
      Writes a typed class from a mod's English MyTexts.resx at build time, and checks each translation
      beside it against the English. A Roslyn source generator, which is what the compiler loads, so it
      targets netstandard2.0.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Release tracking is for analyzers published as packages, which this is not. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>
  <!--
      The copy the mod loads, apart from the build output: a language server holds whatever generator it
      loaded open, so it loads this one, and the copy is replaced only where the generator built differs,
      by content rather than by date. An ordinary build leaves it alone; a change to the generator itself
      is the one time it is written, and the language server has to let go of it for that.
  -->
  <Target Name="CopyForLoading" AfterTargets="Build">
    <PropertyGroup>
      <GeneratorCopy>$(MSBuildThisFileDirectory)bin\Loaded\$(TargetFileName)</GeneratorCopy>
    </PropertyGroup>
    <GetFileHash Files="@(IntermediateAssembly->'%(FullPath)')">
      <Output TaskParameter="Hash" PropertyName="BuiltHash" />
    </GetFileHash>
    <GetFileHash Files="$(GeneratorCopy)" Condition="Exists('$(GeneratorCopy)')">
      <Output TaskParameter="Hash" PropertyName="LoadedHash" />
    </GetFileHash>
    <Copy SourceFiles="@(IntermediateAssembly)" DestinationFiles="$(GeneratorCopy)" Condition="'$(BuiltHash)' != '$(LoadedHash)'" />
  </Target>
</Project>
