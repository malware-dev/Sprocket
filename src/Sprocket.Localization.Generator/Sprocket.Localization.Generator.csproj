<Project Sdk="Microsoft.NET.Sdk">
  <!--
      Writes a typed class from a mod's English MyTexts.resx at build time, and checks each translation
      beside it against the English. A Roslyn source generator, which is what the compiler loads, so it
      targets netstandard2.0.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Release tracking is for analyzers published as packages, which this is not. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>
  <!--
      The copy the mod loads, apart from the build output: a language server holds whatever generator it
      loaded open, so it loads this one. The copy is replaced only where the generator's own sources or
      this project differ from those it was built from, recorded beside it. The built assembly is no guide,
      and neither is everything compiled into it: the SDK stamps the current commit into its informational
      version, so every commit changes its bytes. An ordinary build leaves the copy alone; a change to the
      generator itself is the one time it is written, and the language server has to let go of it for that.
  -->
  <Target Name="CopyForLoading" AfterTargets="Build">
    <PropertyGroup>
      <GeneratorCopy>$(MSBuildThisFileDirectory)bin\Loaded\$(TargetFileName)</GeneratorCopy>
      <GeneratorStamp>$(MSBuildThisFileDirectory)bin\Loaded\sources.hash</GeneratorStamp>
    </PropertyGroup>
    <ItemGroup>
      <GeneratorSourceFile Include="$(MSBuildProjectDirectory)\**\*.cs"
                           Exclude="$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\bin\**" />
    </ItemGroup>
    <GetFileHash Files="@(GeneratorSourceFile->'%(FullPath)');$(MSBuildProjectFullPath)">
      <Output TaskParameter="Items" ItemName="GeneratorSource" />
    </GetFileHash>
    <PropertyGroup>
      <SourcesHash>@(GeneratorSource->'%(FileHash)', '')</SourcesHash>
    </PropertyGroup>
    <ReadLinesFromFile File="$(GeneratorStamp)" Condition="Exists('$(GeneratorStamp)')">
      <Output TaskParameter="Lines" PropertyName="LoadedSourcesHash" />
    </ReadLinesFromFile>
    <Copy SourceFiles="@(IntermediateAssembly)" DestinationFiles="$(GeneratorCopy)"
          Condition="!Exists('$(GeneratorCopy)') Or '$(SourcesHash)' != '$(LoadedSourcesHash)'" />
    <WriteLinesToFile File="$(GeneratorStamp)" Lines="$(SourcesHash)" Overwrite="true"
                      Condition="!Exists('$(GeneratorCopy)') Or '$(SourcesHash)' != '$(LoadedSourcesHash)'" />
  </Target>
</Project>
