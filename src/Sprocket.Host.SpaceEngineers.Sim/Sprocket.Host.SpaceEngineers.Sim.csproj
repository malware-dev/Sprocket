<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\build\Sprocket.GameReferences.props" />

    <!-- The MDK project whose ini says where the game is, read by Lumel.Sim's GameContent. -->
    <ItemGroup>
        <AssemblyMetadata Include="Lumel.MdkProject" Value="$(MSBuildThisFileDirectory)..\Sprocket.Host.SpaceEngineers\Sprocket.Host.SpaceEngineers.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>

        <!--
            The framework the mod's own target is, which is what MDK spells netframework48. So the mod is
            a project reference here rather than a second compilation of its sources: one assembly, built
            once, with its analysers and its whitelist over it, and the harness drives that.
        -->
        <TargetFramework>net48</TargetFramework>
        <UseWPF>true</UseWPF>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Sprocket.Sim</RootNamespace>
        <AssemblyName>Sprocket.Host.SpaceEngineers.Sim</AssemblyName>
        <Platforms>x64</Platforms>

        <!-- The game's assemblies were built against older System.Memory and its kin than the harness carries. -->
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>

        <!-- Picks DirectXTexNet's 64-bit native half, which the game's 64-bit assemblies need. -->
        <PlatformTarget>x64</PlatformTarget>
        <Configurations>Debug;Release</Configurations>

        <!-- "annotations" rather than "enable": the syntax is understood, and no warnings are raised
             against code written years before it existed. -->
        <Nullable>annotations</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>

        <!-- For copying the decoded font page about, which is a megapixel of bytes and is done once per
             color. Confined to the two loops in GlyphAtlas that actually need it. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- STD002 asks what the mod uses, and the harness is no mod: its helpers are there for the tests. -->
        <NoWarn>$(NoWarn);STD002</NoWarn>
    </PropertyGroup>

    <!--
        The font mods the mod requires, each copied whole into a folder of its own, so the simulator draws the same glyphs
        the game will. Referenced where they live rather than duplicated: one page, one set of metrics, and no chance of the
        harness showing symbols the game does not have.
    -->
    <ItemGroup>
        <None Include="..\..\..\Maltek.Symbols\Maltek.Symbols\Content\Data\**\*;..\..\..\Maltek.Symbols\Maltek.Symbols\Content\Fonts\**\*">
            <Link>Content\Mods\Maltek.Symbols\$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)\..\..\..\Maltek.Symbols\Maltek.Symbols\Content\', '%(FullPath)'))</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\..\..\Maltek.Mono\Maltek.Mono\Content\Data\**\*;..\..\..\Maltek.Mono\Maltek.Mono\Content\Fonts\**\*">
            <Link>Content\Mods\Maltek.Mono\$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)\..\..\..\Maltek.Mono\Maltek.Mono\Content\', '%(FullPath)'))</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\..\..\SpaceEngineers.FontStyles\SpaceEngineers.FontStyles\Content\Data\**\*;..\..\..\SpaceEngineers.FontStyles\SpaceEngineers.FontStyles\Content\Fonts\**\*">
            <Link>Content\Mods\SpaceEngineers.FontStyles\$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)\..\..\..\SpaceEngineers.FontStyles\SpaceEngineers.FontStyles\Content\', '%(FullPath)'))</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <!-- The mod's texts and their translations, read the way the game reads them. -->
    <ItemGroup>
        <None Include="..\Sprocket.Host.SpaceEngineers\Content\Data\Localization\*.resx">
            <Link>Content\Localization\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <!-- The mod's own LCD images and materials and their pictures, which the harness draws as the game does. -->
    <ItemGroup>
        <None Include="..\Sprocket.Host.SpaceEngineers\Content\Data\LCDTextures*.sbc;..\Sprocket.Host.SpaceEngineers\Content\Data\TransparentMaterials*.sbc">
            <Link>Content\Mods\Sprocket\Data\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\Sprocket.Host.SpaceEngineers\Content\Textures\**\*.dds">
            <Link>Content\Mods\Sprocket\Textures\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- The game's screen drawn on a desktop, shared through Lumel with every mod's harness. -->
    <Import Project="..\Lumel\Sim\Lumel.Sim.projitems" Label="Shared" />

    <ItemGroup>
        <!-- Impersonates the game's interfaces at runtime, so the harness answers the dozen members
             the mod reads instead of implementing the several hundred it does not. Harness only. -->
        <PackageReference Include="Castle.Core" Version="5.1.1" />

        <!-- The game ships its artwork as block-compressed DDS, which nothing in .NET reads. This is the
             same decoder Malforge's DocGen and MyTsDesigner already use, for the same job; a third
             hand-written BC1 unpacker would only be a third place to get it wrong.

             Touched only on a machine that has the game, because what it produces is cached as PNG and
             it is the cache the other machine reads. It is a managed wrapper over a native library, so
             it loads when it is first called and not before. -->
        <PackageReference Include="DirectXTexNet" Version="1.0.1" />
    </ItemGroup>

    <!--
        The game's protobuf model, which the game installs as it starts and the harness has to install itself, to measure
        the game's binary serialization the way the game runs it. The package references only the attributes and the
        serializer.
    -->
    <Target Name="ReferenceTheGamesProtobufModel" AfterTargets="SpaceEngineers">
        <ItemGroup>
            <Reference Include="ProtoBuf.Net">
                <HintPath>$(SpaceEngineersBinPath)\ProtoBuf.Net.dll</HintPath>
                <Private>true</Private>
            </Reference>
        </ItemGroup>
    </Target>

    <!--
        The mod itself: core, the screens, the world layer and the session, as one assembly.

        Not a port and not a stand-in. The harness drives the same GridWorld, SprocketUnit and screens
        the game drives, over blocks it makes up, which is what puts the toolbar and storage layer -
        the fiddliest code in the repo - under the reference frames.

        A reference rather than a second compilation of the sources, which is what this was until the
        mod stopped reaching for the game's statics directly. What it asks of the game now arrives
        through two interfaces - IScreenSpace for the screen, ISlots for the toolbars - and the harness
        answers both. A recorded frame is what it writes down instead of drawing.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Sprocket.Host.SpaceEngineers\Sprocket.Host.SpaceEngineers.csproj" />
    </ItemGroup>
    <!-- Held to the same standards as the mod; loaded from its copy, see Loaded.targets. -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\..\BuildTools\Standards\Sprocket.Standards\Sprocket.Standards.csproj" ReferenceOutputAssembly="false" />
        <Analyzer Include="..\..\..\..\..\BuildTools\Standards\Sprocket.Standards\bin\Loaded\Sprocket.Standards.dll" />
    </ItemGroup>
</Project>
