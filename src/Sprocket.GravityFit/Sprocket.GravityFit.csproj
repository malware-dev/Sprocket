<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
      Gravity Field Fit, a mod of its own: the buttons on a box gravity generator that size its field to its grid or its rooms.
      C# 6 with no nullable or implicit usings, for the same reason as the Sprocket mod: the game compiles the loose
      files itself, under its whitelist, with a compiler assumed to stop at C# 6.
  -->
  <PropertyGroup>
    <TargetFramework>netframework48</TargetFramework>
    <RootNamespace>Sprocket.GravityFit</RootNamespace>
    <LangVersion>6</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <WarningLevel>5</WarningLevel>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Release;Debug</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sprocket.Standards\Sprocket.Standards.csproj" ReferenceOutputAssembly="false" />
    <Analyzer Include="..\Sprocket.Standards\bin\Loaded\Sprocket.Standards.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.16">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.Mdk2.ModPackager" Version="2.2.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Content\*\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AdditionalFiles>
    <AdditionalFiles Include="thumb.png" Condition="Exists('thumb.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AdditionalFiles>
    <None Remove="thumb.png" />
  </ItemGroup>
  <Import Project="..\Sprocket.Gravity\Sprocket.Gravity.projitems" Label="Shared" />
</Project>