<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RootNamespace>Reactor.Host</RootNamespace>
        <AssemblyName>Reactor.Host.Avalonia</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.16" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Reactor.Core\Reactor.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Reactor.Host.Tests" />
    </ItemGroup>

    <!-- The simulated ship, shared with the Space Engineers screen simulator. It was always written to be
         independent of any window; this makes that structural rather than a claim in a comment. -->
    <Import Project="..\Reactor.Machine.Mixin\Reactor.Machine.Mixin.projitems" Label="Shared" />

</Project>
