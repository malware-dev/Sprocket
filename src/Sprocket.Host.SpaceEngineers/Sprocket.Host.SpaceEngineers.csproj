<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netframework48</TargetFramework>
    <RootNamespace>Sprocket.Host.SpaceEngineers</RootNamespace>
    <!--
        C# 6, and it is not a preference.

        Space Engineers does not load assemblies: it compiles a mod's loose .cs files in-game with its
        own bundled Roslyn, under a whitelist. That path fails silently - write a tuple on a Tuesday
        and find out in-game weeks later - so the ceiling is enforced by the compiler here instead, on
        every build. C# 6 is the conservative assumption for the in-game compiler; raising it is a
        one-line change once the real ceiling has been verified in the game.

        Nullable reference types are C# 8 and the directive is a hard error on an older compiler, and
        implicit usings need one too. Both off for the same reason.
    -->
    <LangVersion>6</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- This runs inside a 60Hz game loop. Unused and unreachable code, and accidental allocations,
         are worth hearing about. -->
    <WarningLevel>5</WarningLevel>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Release;Debug</Configurations>
    <Platforms>x64</Platforms>
    <!-- The texts in Content\Data\Localization\MyTexts.resx become the class Framework.Text.Texts. Every key
         starts with the prefix, because the game keeps every mod's texts in one table with its own. -->
    <LocalizationPrefix>Sprocket.</LocalizationPrefix>
    <LocalizationNamespace>Sprocket.Host.SpaceEngineers.Framework.Text</LocalizationNamespace>
    <LocalizationRuntime>Sprocket.Host.SpaceEngineers.Framework.Text</LocalizationRuntime>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="LocalizationPrefix" />
    <CompilerVisibleProperty Include="LocalizationNamespace" />
    <CompilerVisibleProperty Include="LocalizationRuntime" />
    <!-- Both built first, and loaded from the copy each keeps for loading; see Loaded.targets. -->
    <ProjectReference Include="..\Sprocket.Localization.Generator\Sprocket.Localization.Generator.csproj" ReferenceOutputAssembly="false" />
    <Analyzer Include="..\Sprocket.Localization.Generator\bin\Loaded\Sprocket.Localization.Generator.dll" />
    <ProjectReference Include="..\Sprocket.Standards\Sprocket.Standards.csproj" ReferenceOutputAssembly="false" />
    <Analyzer Include="..\Sprocket.Standards\bin\Loaded\Sprocket.Standards.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.17">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.Mdk2.ModPackager" Version="2.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.MdkModMixin.Network" Version="1.0.0" />
    <PackageReference Include="Mal.MdkModMixin.Lumel" Version="1.0.0-beta.3" />
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Content\*\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AdditionalFiles>
    <AdditionalFiles Include="thumb.png" Condition="Exists('thumb.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AdditionalFiles>
    <!-- The license travels with every copy of the mod (its clause 1.0). -->
    <AdditionalFiles Include="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AdditionalFiles>
    <AdditionalFiles Remove="Content\*\**\*.cs" />
    <None Remove="thumb.png" />
    <None Remove="LICENSE.txt" />
  </ItemGroup>
</Project>