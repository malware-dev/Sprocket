<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <TransparentMaterials>
        <!--
            The editor draws sprites by material id, and these are the ones it needs to exist.

            The textures are the game's own wherever the game has one: the cursor a player already knows is the
            right cursor to draw, and there is no id to reach it by, because GuiTextures.sbc never names it.
            Declaring a material pointing at the same file is the way to it. The logo and the shadow a floating
            window casts are this mod's own.
        -->

        <!-- The logo, which the codex's home page opens with. The sprite twin of the LCD image, premultiplied. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Sprocket_Mark</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Sprocket_Mark.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- The game's own sleeping face, from its emotion controller's pictures, over the paused automation's screen. The
             picture keeps no alpha, so drawn premultiplied its black adds nothing and only the face shows. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Sprocket_Sleepy</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Models\Emotes\Sleepy.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- The shadow a floating window casts, drawn as a nine-slice. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Sprocket_Shadow</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Sprocket_Shadow.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- Every hue, red at the top round to red at the bottom: the color picker's strip of hues. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Sprocket_Hues</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Sprocket_Hues.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- White, solid at the left and gone at the right: laid over a fill of one hue, saturation across. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Sprocket_Pale</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Sprocket_Pale.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- Black, gone at the top and solid at the bottom: laid over the pale fade, value up. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Sprocket_Dark</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Sprocket_Dark.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- The hazard stripes a warning or an error lies on, laid edge to edge across a row. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Sprocket_Stripes</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Sprocket_Stripes.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

    </TransparentMaterials>
</Definitions>
