<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <Fonts>
        <!--
            A proportional face for reading, in regular, bold, italic and bold italic: prose rather than a listing,
            with strong and emphasized words given a shape of their own.

            Cut to the same line height and baseline as the game's own faces and Maltek Mono, so a line of it
            occupies exactly the height of a line anywhere else and sits on the same baseline.

            The letterforms are Inter, by the Inter Project Authors, under the SIL Open Font License 1.1 - see
            Fonts\Maltek\OFL.txt, which ships because the license requires every copy to carry the notice and the
            license. It is named by what it is, as Maltek Mono is, because a subtype here is a lookup key rather
            than a byline.

            A mod of its own, for any display mod to require rather than carry: two mods carrying their own copies
            would declare the same subtype and disagree about what is in it.
        -->
        <Font>
            <Id>
                <TypeId>FontDefinition</TypeId>
                <SubtypeId>MaltekSans</SubtypeId>
            </Id>
            <Path>Fonts\Maltek\MaltekSans.xml</Path>
        </Font>
        <Font>
            <Id>
                <TypeId>FontDefinition</TypeId>
                <SubtypeId>MaltekSansBold</SubtypeId>
            </Id>
            <Path>Fonts\Maltek\MaltekSansBold.xml</Path>
        </Font>
        <Font>
            <Id>
                <TypeId>FontDefinition</TypeId>
                <SubtypeId>MaltekSansItalic</SubtypeId>
            </Id>
            <Path>Fonts\Maltek\MaltekSansItalic.xml</Path>
        </Font>
        <Font>
            <Id>
                <TypeId>FontDefinition</TypeId>
                <SubtypeId>MaltekSansBoldItalic</SubtypeId>
            </Id>
            <Path>Fonts\Maltek\MaltekSansBoldItalic.xml</Path>
        </Font>
    </Fonts>
</Definitions>
