<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Turns a page of glyphs into the texture Space Engineers actually loads: premultiplied,
        mipped, BC7_UNORM_SRGB. The font it serves is meant to be shared between mods rather
        than to belong to any one of them, so this is a small standalone tool that moves out
        whole along with it.

        DirectXTexNet is the same package Malforge's DocGen uses against the same game. It is
        native and win-x64 only, which is no new constraint here.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AssemblyName>FontTool</AssemblyName>
        <RootNamespace>Maltek.FontTool</RootNamespace>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DirectXTexNet" Version="1.0.1" />
    </ItemGroup>

</Project>
