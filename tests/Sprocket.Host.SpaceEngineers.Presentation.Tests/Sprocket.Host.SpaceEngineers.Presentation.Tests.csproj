<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\build\Sprocket.GameReferences.props" />

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <UseWPF>true</UseWPF>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- xunit v3 test projects are executables. -->
        <OutputType>Exe</OutputType>
        <RootNamespace>Sprocket.Host.SpaceEngineers.Presentation.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    </ItemGroup>

    <!-- The simulator, which draws the real Space Engineers screen code against a substitute of the
         game's graphics. Testing against it tests what ships. -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\Sprocket.Host.SpaceEngineers.Sim\Sprocket.Host.SpaceEngineers.Sim.csproj" />
    </ItemGroup>

    <!-- The editor driven the way a target drives it, in every test. -->
    <ItemGroup>
        <Using Include="Sprocket.Sim.Driving" />
    </ItemGroup>
</Project>
