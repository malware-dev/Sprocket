<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- xunit v3 test projects are executables. -->
        <OutputType>Exe</OutputType>
        <RootNamespace>Sprocket.Wiki.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    </ItemGroup>

    <!-- The wiki written from the repository's own codex and pictures, with no game. -->
    <ItemGroup>
        <ProjectReference Include="..\..\tools\Sprocket.Wiki\Sprocket.Wiki.csproj" />
    </ItemGroup>
</Project>
