<Project Sdk="Microsoft.NET.Sdk">

    <!--
        A plugin for the dedicated server that runs Sprocket's game tests in a real world: it pastes a scenario's
        blueprint, acts on its blocks as a player would, reads what the real game did, and writes a report. It is
        loaded only by the test runner with -plugin, built from this repository, and never shipped with the mod.
    -->
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <Nullable>annotations</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>Sprocket.GameTests</RootNamespace>
        <AssemblyName>Sprocket.GameTests</AssemblyName>

        <!-- The server loads its own copies of the game's assemblies; this plugin brings none of them. -->
        <SpaceEngineersBinCopyLocal>false</SpaceEngineersBinCopyLocal>
    </PropertyGroup>

    <!-- The game's assemblies, found through the mdk.local.ini beside this file: the dedicated server's Bin64. -->
    <ItemGroup>
        <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
