<?xml version="1.0" encoding="utf-8"?>

<!--
  What this is for.

  Space Engineers lets a block declare actions, and a toolbar action may take parameters. What the
  game declares about those parameters is how many there are and a type for each, and the type is
  often not the one the action accepts. It does not say what any of them is for or what to call it -
  so an automation editor showing them has nothing to put beside the boxes, and has to ask for three
  unnamed numbers where a person was thinking of one colour.

  This file is how a mod says what its own actions' parameters are. Put it in your mod at
  Data/SprocketDefinitions.xml and Sprocket will read it when the world loads. It is
  plain data: nothing is registered, nothing has to load in any order, and a mod that ships one
  works perfectly well in a world where Sprocket is not installed, because a file nobody
  reads does nothing.

  Every parameter of an action must be described, in the order the action declares them. Where
  several parameters are one thing to a person - a colour written as three numbers - put them in a
  group and say what kind of thing they are together; the editor for that kind is then what people
  get instead of three boxes. A description that does not account for every parameter is ignored
  and said so in the game log, because names against the wrong values are worse than no names.

  Anything here that this build does not understand is ignored rather than refused: an unknown kind
  falls back to plain values and keeps its names. So a file written for a later build still works.

  There is no XML namespace, deliberately: your file is a handful of plain elements and a namespace
  on it would be one more thing to get right. For completion in an editor, point at this schema:

    <sprocket-definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xsi:noNamespaceSchemaLocation="SprocketDefinitions.xsd">
-->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified"
           attributeFormDefault="unqualified">

  <xs:element name="sprocket-definitions">
    <xs:annotation>
      <xs:documentation>
        Everything one mod says about its own blocks. Broader than the actions it holds today,
        because what a block can be asked about and what moments it raises belong in the same file.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="actions" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="action" type="action" minOccurs="0" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="action">
    <xs:annotation>
      <xs:documentation>
        One terminal action, and what its parameters are. Describe them in the order the action
        declares them, and describe all of them.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="parameter" type="parameter" />
        <xs:element name="group" type="group" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          The action's own id, as the game knows it - the same string a toolbar slot holds. Not its
          display name.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="block" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          The full definition id of the block it is on, type and subtype, as the game spells it:
          MyObjectBuilder_InteriorLight/LargeBlockLight_1corner. Leave it out to describe the
          action wherever that id appears, which is the weaker claim and loses to one naming a
          block. An action id is unique on a block and not in the game, so naming the block is
          almost always what you mean.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="parameter" mixed="true">
    <xs:annotation>
      <xs:documentation>
        One parameter. The element's own text, if any, is a longer note about it, shown where there
        is room for one.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          What to call it. Left out, it is shown by its place in the order instead.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          The least this parameter may be, shown beside its name so somebody knows before they
          type, and held to: a value outside the bounds is refused where it is typed, with the
          bounds said back. Either bound may be given on its own. Nothing about the action says
          what it will accept, so this is the only place it can be said. A bound that cannot be
          read as a number is shown and holds nobody to anything.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max" type="xs:string">
      <xs:annotation>
        <xs:documentation>The most it may be. See min.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="kind" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          The type the action accepts here, named as .NET names it, in lower case: boolean, byte,
          sbyte, int16, uint16, int32, uint32, int64, uint64, single, double, char or string. Left
          out, the type the action declares for it stands. Give it wherever that declaration is
          wrong - an action that declares a string and refuses anything but a number is the usual
          case. The value is handed to the action as exactly this type. A program step holding a
          value that is not this type, or does not fit in it, is at fault and does not run; a whole
          number is taken where a single or double is wanted. A name this build does not know
          leaves the declaration standing.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="group">
    <xs:annotation>
      <xs:documentation>
        Several parameters that are one thing to a person. How many it covers is how many are in it,
        so there is nothing to count and nothing to keep in step.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="parameter" type="parameter" minOccurs="1" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="kind" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          What the parameters are together, which decides what people are given to edit them with.
          Known kinds: color - three parameters, red, green and blue. A kind this build does not
          know falls back to plain values and keeps the names inside it.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

</xs:schema>
